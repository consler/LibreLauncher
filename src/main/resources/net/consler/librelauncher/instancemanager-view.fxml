<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="net.consler.librelauncher.ui.instance.manager.InstanceManagerController"
            prefHeight="400.0" prefWidth="600.0">
    <children>
        <HBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>

                <VBox prefWidth="250.0" spacing="10.0">
                    <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                    </padding>
                    <children>
                        <Button maxWidth="Infinity" text="New Instance" onAction="#newInstanceButtonClicked" />
                        <Button maxWidth="Infinity" text="Open Instances Folder" onAction="#openFolderButtonClicked" />
                    </children>
                </VBox>

                <Separator orientation="VERTICAL" />

                <ListView fx:id="instanceList" HBox.hgrow="ALWAYS"/>

            </children>
        </HBox>
    </children>
</AnchorPane>